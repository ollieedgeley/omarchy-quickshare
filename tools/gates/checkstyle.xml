<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <module name="BeforeExecutionExclusionFileFilter">
    <property name="fileNamePattern" value="[/\\]generated[/\\]"/>
  </module>
  <module name="FileLength">
    <property name="fileExtensions" value="rs,py,cc,cpp,c,h,hpp,java,qml,sh"/>
    <property name="max" value="${file.max}" default="500"/>
  </module>
  <module name="LineLength">
    <property name="fileExtensions" value="rs,cc,cpp,c,h,hpp,java,qml,sh"/>
    <property name="max" value="80"/>
    <property name="ignorePattern" value="^$"/>
  </module>
  <module name="TreeWalker">
    <property name="fileExtensions" value="java"/>
    <module name="MethodLength">
      <property name="max" value="50"/>
    </module>
  </module>
</module>

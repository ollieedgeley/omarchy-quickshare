ARG BASE_IMAGE=\
debian@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171
FROM ${BASE_IMAGE}

ARG DEBIAN_SNAPSHOT=20260901T000000Z
RUN rm -f /etc/apt/sources.list.d/* \
    && printf '%s\n' \
      "deb [check-valid-until=no] http://snapshot.debian.org/archive/"\
"debian/${DEBIAN_SNAPSHOT}/ bookworm main" \
      > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && DEBIAN_FRONTEND=noninteractive \
      apt-get install --yes --no-install-recommends \
      build-essential \
      hostapd \
      iproute2 \
      iputils-ping \
      iw \
      libconfig-dev \
      libnl-3-dev \
      libnl-genl-3-dev \
      pkg-config \
      procps \
      python3 \
      wpasupplicant \
    && rm -rf /var/lib/apt/lists/*

ARG ENVIRONMENT_FINGERPRINT
LABEL org.omarchy-quickshare.environment="network" \
      org.omarchy-quickshare.fingerprint="${ENVIRONMENT_FINGERPRINT}"

+std::string TokenFingerprint(std::string_view token) {
+  const char* salt = std::getenv("QUICKSHARE_PIN_SALT");
+  if (salt == nullptr || *salt == '\0') {
+    return "";
+  }
+  uint64_t hash = 14695981039346656037ULL;
+  for (unsigned char value : std::string_view(salt)) {
+    hash ^= value;
+    hash *= 1099511628211ULL;
+  }
+  for (unsigned char value : token) {
+    hash ^= value;
+    hash *= 1099511628211ULL;
+  }
+  std::ostringstream output;
+  output << std::hex << hash;
+  return output.str();
+}

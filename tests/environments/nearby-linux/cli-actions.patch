+bool RetryInjectionRequested() {
+  return std::getenv("QUICKSHARE_INJECT_RETRY12") != nullptr;
+}
+
+std::string BandwidthUpgradeRetry() {
+  OfflineFrame frame;
+  frame.set_version(OfflineFrame::V1);
+  auto* v1_frame = frame.mutable_v1();
+  v1_frame->set_type(V1Frame::BANDWIDTH_UPGRADE_RETRY);
+  auto* retry = v1_frame->mutable_bandwidth_upgrade_retry();
+  retry->add_supported_medium(
+      ::location::nearby::connections::BandwidthUpgradeRetryFrame::WIFI_LAN);
+  retry->set_is_request(false);
+  return frame.SerializeAsString();
+}
+
+std::string KeepAliveRequest() {
+  OfflineFrame frame;
+  frame.set_version(OfflineFrame::V1);
+  auto* v1_frame = frame.mutable_v1();
+  v1_frame->set_type(V1Frame::KEEP_ALIVE);
+  auto* keep_alive = v1_frame->mutable_keep_alive();
+  keep_alive->set_ack(false);
+  keep_alive->set_seq_num(12);
+  return frame.SerializeAsString();
+}
+
+bool IsRetryInjectionPoint(
+    const PayloadTransferFrame::PayloadHeader& header,
+    const PayloadTransferFrame::PayloadChunk& chunk) {
+  if (chunk.offset() != 0) {
+    return false;
+  }
+  if (header.type() == PayloadTransferFrame::PayloadHeader::FILE) {
+    return true;
+  }
+  const char* expected = std::getenv("QUICKSHARE_INJECT_RETRY12_BYTES");
+  return expected != nullptr &&
+         header.type() == PayloadTransferFrame::PayloadHeader::BYTES &&
+         chunk.body() == expected;
+}
+
+bool IsRetryInjectionPoint(const OfflineFrame& frame) {
+  if (parser::GetFrameType(frame) != V1Frame::PAYLOAD_TRANSFER) {
+    return false;
+  }
+  const auto& transfer = frame.v1().payload_transfer();
+  return transfer.has_payload_header() && transfer.has_payload_chunk() &&
+         IsRetryInjectionPoint(transfer.payload_header(),
+                               transfer.payload_chunk());
+}
+
+void ReportControlInjection(const char* frame_type, const char* position) {
+  std::cout << "QS_EVENT event=control-frame frame_type=" << frame_type
+            << " position=" << position << std::endl;
+}
+
+Exception InjectRetry(std::shared_ptr<EndpointChannel> channel,
+                      const char* position) {
+  Exception result = channel->Write(BandwidthUpgradeRetry());
+  if (!result.Ok()) {
+    return result;
+  }
+  ReportControlInjection("bandwidth-upgrade-retry", position);
+  if (std::getenv("QUICKSHARE_INJECT_RETRY12_BYTES") == nullptr) {
+    return result;
+  }
+  result = channel->Write(KeepAliveRequest());
+  if (result.Ok()) {
+    ReportControlInjection("keepalive", position);
+  }
+  return result;
+}


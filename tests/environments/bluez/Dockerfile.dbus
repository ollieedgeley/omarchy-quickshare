FROM debian@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171

ARG DEBIAN_SNAPSHOT=20260901T000000Z
RUN rm -f /etc/apt/sources.list.d/* \
    && printf '%s\n' \
      "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}/ bookworm main" \
      > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
      bluez \
      dbus \
      network-manager \
      python3 \
      python3-dbus \
      python3-gi \
      python3-packaging \
    && rm -rf /var/lib/apt/lists/*

ARG ENVIRONMENT_FINGERPRINT
LABEL org.omarchy-quickshare.environment="dbus" \
      org.omarchy-quickshare.fingerprint="${ENVIRONMENT_FINGERPRINT}"

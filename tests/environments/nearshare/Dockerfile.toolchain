ARG BASE_IMAGE=\
debian@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171
FROM ${BASE_IMAGE}

ARG DEBIAN_SNAPSHOT=20260901T000000Z
ARG ENVIRONMENT_FINGERPRINT

RUN rm -f /etc/apt/sources.list.d/* \
    && printf '%s\n' \
      "deb [check-valid-until=no] http://snapshot.debian.org/archive/"\
"debian/${DEBIAN_SNAPSHOT} bookworm main" \
      > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install --yes --no-install-recommends \
      python3=3.11.2-1+b1 \
      python3-cryptography=38.0.4-3+deb12u1 \
      python3-grpc-tools=1.14.1-6 \
      python3-pkg-resources=66.1.1-1+deb12u2 \
      python3-protobuf=3.21.12-3+deb12u1 \
      python3-zeroconf=0.47.3-1 \
    && rm -rf /var/lib/apt/lists/*

LABEL org.opencontainers.image.title="omarchy-quickshare NearShare peer" \
      org.opencontainers.image.source=\
"https://github.com/ollieedgeley/omarchy-quickshare" \
      io.omarchy-quickshare.environment="${ENVIRONMENT_FINGERPRINT}"

ENV HOME=/work/home \
    PYTHONPATH=/work/nearshare \
    XDG_RUNTIME_DIR=/work/runtime

WORKDIR /work/nearshare

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    ".omp/hooks/**/*.js",
    "eslint.config.mjs",
    "tools/**/*.mjs",
    "tests/**/*.mjs"
  ],
  "project": [
    ".omp/hooks/**/*.js",
    "eslint.config.mjs",
    "tools/**/*.mjs",
    "tests/**/*.mjs"
  ],
  "includeEntryExports": true,
  "treatConfigHintsAsErrors": true,
  "rules": {
    "binaries": "error",
    "catalog": "error",
    "catalogReferences": "error",
    "cycles": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "duplicates": "error",
    "enumMembers": "error",
    "exports": "error",
    "files": "error",
    "namespaceMembers": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "optionalPeerDependencies": "error",
    "types": "error",
    "unlisted": "error",
    "unresolved": "error"
  }
}
